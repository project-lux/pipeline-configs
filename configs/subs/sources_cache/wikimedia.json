{
    "name": "wikimedia",
    "type": "external",
    "namespace": "http://commons.wikimedia.org/",
    "matches": ["commons.wikimedia.org/"],
    "fetch": "https://en.wikipedia.org/w/api.php?action=query&prop=imageinfo&iiprop=extmetadata&titles=File:{identifier}&format=json",

    "fetcherClass": "sources.wikimedia.fetcher.WmFetcher",
    "mapperClass": "sources.wikimedia.mapper.WmMapper",
    "loaderClass": "sources.wikimedia.loader.WmLoader",
    "image_extensions": ["jpg", "jpeg", "png", "gif", "webp", "svg"],
    "totalRecords": 43000000,
    "dumps_dir": "wikimedia",
    "input_files": {
        "records": [{"path": "commonswiki", "type": "dir/mediawiki.bz2/raw", "slice": "files",
                     "include": ["*-pages-articles-multistream[0-9]*.xml-p*.bz2",
                                 "commonswiki-*-p[0-9]*p[0-9]*.xml.bz2"]}]
    },
    "rsync": {
        "source": "rsync://dumps.wikimedia.your.org/wikimedia-dumps/commonswiki/latest/",
        "path": "commonswiki",
        "include": ["commonswiki-latest-pages-articles-multistream[0-9]*.xml-p*.bz2"]
    }
}
